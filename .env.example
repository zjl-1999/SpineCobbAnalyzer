# =============================================================================
# SpineCobbAnalyzer Environment Variables
# =============================================================================
# First time: copy this file as .env.example or directly edit .env.
# .env is in .gitignore and will never be committed.
#
# Where to get keys:
#   Gemini:     https://aistudio.google.com/apikey
#   SiliconFlow: https://cloud.siliconflow.cn/  (Chinese-friendly, free credits)
#   Claude:     https://console.anthropic.com/
#   OpenAI:     https://platform.openai.com/api-keys
# =============================================================================

# Google Gemini API Key (starts with AIza)
# GEMINI_API_KEY=AIza...

# SiliconFlow API Key (starts with sk-)
# SILICONFLOW_API_KEY=sk-...

# Anthropic Claude API Key (starts with sk-ant-)
# CLAUDE_API_KEY=sk-ant-...

# OpenAI API Key (starts with sk-)
# OPENAI_API_KEY=sk-...
